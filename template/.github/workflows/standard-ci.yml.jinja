# Managed by the repository standard; change it only with the owner's approval.
name: standard-ci

on:
  pull_request:
    branches: {{ required_ci_branches | tojson }}
  push:
    branches: {{ required_ci_branches | tojson }}
{% raw %}
concurrency:
  group: standard-ci-${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

permissions:
  contents: read
  # ci-merged-pr reads the pull requests of the pushed commit.
  pull-requests: read

jobs:
  check:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
      # Git 2.54+ stores hk hooks in git config; the log records which mode CI exercises.
      - name: Git version
        run: git --version
      - uses: jdx/mise-action@f5be966e4a917d54244728e6a5fdcd1d93a35e6c # v5.2.6
      # A commit of a merged pull request was checked in the pull request.
      - name: Merged pull request (push)
        id: merged
        if: ${{ github.event_name == 'push' }}
        env:
          REPO: ${{ github.repository }}
          SHA: ${{ github.sha }}
          GH_TOKEN: ${{ github.token }}
        run: echo "merged=$(mise run ci-merged-pr -- "$REPO" "$SHA")" >> "$GITHUB_OUTPUT"
      - name: Checks
        if: ${{ github.event_name != 'push' || steps.merged.outputs.merged != 'true' }}
        run: mise run check
      # The base is the pull request base, or the previous tip of the pushed branch.
      - name: Baseline growth (pull request)
        if: ${{ !cancelled() && github.event_name == 'pull_request' }}
        env:
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
        run: mise run check-baseline -- "$BASE_SHA"
      - name: Baseline growth (push)
        if: ${{ !cancelled() && github.event_name == 'push' }}
        env:
          BASE_SHA: ${{ github.event.before }}
        run: |
          # `before` is all zeros when the branch is new.
          if [ -z "${BASE_SHA//0/}" ]; then
            echo "new branch, no base"
          else
            mise run check-baseline -- "$BASE_SHA"
          fi
      # Cloud sessions commit without hk, so every commit of the pull request is linted here.
      - name: Commit messages
        if: ${{ !cancelled() && github.event_name == 'pull_request' }}
        env:
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
        run: mise run check-pr-commits -- "$BASE_SHA" "$HEAD_SHA"
      - name: Commit messages (merged push)
        if: ${{ !cancelled() && github.event_name == 'push' && steps.merged.outputs.merged == 'true' }}
        env:
          BASE_SHA: ${{ github.event.before }}
          HEAD_SHA: ${{ github.sha }}
        run: |
          if [ -z "${BASE_SHA//0/}" ]; then
            echo "new branch, no base"
          else
            mise run check-pr-commits -- "$BASE_SHA" "$HEAD_SHA"
          fi
      - name: Pull request description
        if: ${{ !cancelled() && github.event_name == 'pull_request' }}
        env:
          PR_BODY: ${{ github.event.pull_request.body }}
        run: mise run check-pr-body
{% endraw %}
