# Managed by the repository standard; change it only with the owner's approval.
name: standard-ci

on:
  pull_request:
    branches: {{ required_ci_branches | tojson }}
  push:
    branches: {{ required_ci_branches | tojson }}
{% raw %}
concurrency:
  group: standard-ci-${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

permissions:
  contents: read
  # ci-merged-pr reads the pull requests of the pushed commit and the checks of their heads.
  pull-requests: read
  checks: read

jobs:
  check:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
      # Git 2.54+ stores hk hooks in git config; the log records which mode CI exercises.
      - name: Git version
        run: git --version
      - uses: jdx/mise-action@f5be966e4a917d54244728e6a5fdcd1d93a35e6c # v5.2.6
{%- endraw %}
{%- if 'typescript' in stack %}
{%- raw %}
      # The hooks run ESLint, Prettier and the other tools from `node_modules`.
      - name: Node dependencies
        run: |
          if [ -f pnpm-lock.yaml ]; then
            pnpm install --frozen-lockfile
          elif [ -f package-lock.json ]; then
            npm ci
          else
            echo "pnpm-lock.yaml or package-lock.json is required"
            exit 1
          fi
{%- endraw %}
{%- endif %}
{%- raw %}
      # A commit of a merged pull request with a green `check` run was checked in the pull request.
      - name: Merged pull request (push)
        id: merged
        if: ${{ github.event_name == 'push' }}
        env:
          REPO: ${{ github.repository }}
          SHA: ${{ github.sha }}
          GH_TOKEN: ${{ github.token }}
        run: echo "merged=$(mise run ci-merged-pr -- "$REPO" "$SHA")" >> "$GITHUB_OUTPUT"
      - name: Checks
        if: ${{ github.event_name != 'push' || steps.merged.outputs.merged != 'true' }}
{%- endraw %}
{%- if 'typescript' in stack %}
{%- raw %}
        # The runner's default V8 heap is 2 GB; type-aware ESLint of a large project needs more.
        # 4 GB is the default heap of a developer machine, so CI and the hooks have the same limit.
        env:
          NODE_OPTIONS: --max-old-space-size=4096
{%- endraw %}
{%- endif %}
{%- raw %}
        run: mise run check
{%- endraw %}
{%- if 'typescript' in stack %}
{%- raw %}
      # Typecheck does not run the bundler or the build tsconfig; a broken build would surface at release.
      - name: Build
        if: ${{ github.event_name != 'push' || steps.merged.outputs.merged != 'true' }}
        run: npm run --if-present build
{%- endraw %}
{%- endif %}
{%- raw %}
      # The base is the pull request base, or the previous tip of the pushed branch.
      - name: Baseline growth (pull request)
        if: ${{ !cancelled() && github.event_name == 'pull_request' }}
        env:
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
        run: mise run check-baseline -- "$BASE_SHA"
      - name: Baseline growth (push)
        if: ${{ !cancelled() && github.event_name == 'push' }}
        env:
          BASE_SHA: ${{ github.event.before }}
        run: |
          # `before` is all zeros when the branch is new.
          if [ -z "${BASE_SHA//0/}" ]; then
            echo "new branch, no base"
          else
            mise run check-baseline -- "$BASE_SHA"
          fi
      - name: ADR history (pull request)
        if: ${{ !cancelled() && github.event_name == 'pull_request' }}
        env:
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
        run: mise run check-adr-history -- "$BASE_SHA" HEAD
      # Cloud sessions commit without hk, so every commit of the pull request is linted here.
      - name: Commit messages
        if: ${{ !cancelled() && github.event_name == 'pull_request' }}
        env:
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
        run: mise run check-pr-commits -- "$BASE_SHA" "$HEAD_SHA"
      - name: Commit messages (merged push)
        if: ${{ !cancelled() && github.event_name == 'push' && steps.merged.outputs.merged == 'true' }}
        env:
          BASE_SHA: ${{ github.event.before }}
          HEAD_SHA: ${{ github.sha }}
        run: |
          if [ -z "${BASE_SHA//0/}" ]; then
            echo "new branch, no base"
          else
            mise run check-pr-commits -- "$BASE_SHA" "$HEAD_SHA"
          fi
{%- endraw %}
{%- if 'typescript' in stack %}
{%- raw %}
      # The threshold in `.jscpd.json` is the measured duplication; check-baseline keeps it from rising.
      - name: Duplication
        if: ${{ !cancelled() && github.event_name == 'pull_request' }}
        run: |
          test -f .jscpd.json || { echo ".jscpd.json is missing"; exit 1; }
          jscpd --config .jscpd.json --no-tips .
{%- endraw %}
{%- endif %}
{%- raw %}
      - name: Pull request description
        if: ${{ !cancelled() && github.event_name == 'pull_request' }}
        env:
          PR_BODY: ${{ github.event.pull_request.body }}
        run: mise run check-pr-body
{% endraw %}
