# Managed by the repository standard; changes arrive with `copier update`.
name: standard-ci

on:
  pull_request:
    branches: {{ required_ci_branches | tojson }}
  push:
    branches: {{ required_ci_branches | tojson }}
{% raw %}
concurrency:
  group: standard-ci-${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  check:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
      - uses: jdx/mise-action@f5be966e4a917d54244728e6a5fdcd1d93a35e6c # v5.2.6
      - run: mise run check
      # The base is the pull request base, or the previous tip of the pushed branch.
      - name: Baseline growth (pull request)
        if: github.event_name == 'pull_request'
        env:
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
        run: mise run check-baseline -- "$BASE_SHA"
      - name: Baseline growth (push)
        if: github.event_name == 'push'
        env:
          BASE_SHA: ${{ github.event.before }}
        run: |
          # `before` is all zeros when the branch is new.
          if [ -z "${BASE_SHA//0/}" ]; then
            echo "new branch, no base"
          else
            mise run check-baseline -- "$BASE_SHA"
          fi
      # Cloud sessions commit without hk, so every commit of the pull request is linted here.
      - name: Commit messages
        if: github.event_name == 'pull_request'
        env:
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
        run: mise run check-pr-commits -- "$BASE_SHA" "$HEAD_SHA"
      - name: Pull request description
        if: github.event_name == 'pull_request'
        env:
          PR_BODY: ${{ github.event.pull_request.body }}
        run: mise run check-pr-body
{% endraw %}
