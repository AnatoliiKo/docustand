{%- set fsd = [] -%}
{%- for part, value in architecture.items() -%}
{%- set style = value if value is string else ((value.style or '') if value is mapping else '') -%}
{%- if 'fsd' in style | lower or 'feature-sliced' in style | lower -%}
{%- set _ = fsd.append(part) -%}
{%- endif -%}
{%- endfor -%}
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".config/dependency-cruiser.cjs", ".config/dependency-cruiser.standard.cjs", ".config/commitlint.config.mjs"{% if fsd %}, "steiger.config.*"{% endif %}],
  "ignoreDependencies": ["prettier", "dependency-cruiser"{% if fsd %}, "steiger", "@feature-sliced/steiger-plugin"{% endif %}]
}
