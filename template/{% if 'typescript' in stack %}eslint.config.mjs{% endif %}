// Project rules come first and the standard rules last, so the project cannot weaken them.
// A stricter threshold or a global ignore is an edit of this file with an entry in `overrides`.
import { defineConfig } from 'eslint/config';
import sonarjs from 'eslint-plugin-sonarjs';
import tseslint from 'typescript-eslint';
import project from './.config/eslint.project.mjs';

// The pre-commit hook sets ESLINT_NO_TYPES=1: rules with type information exceed its 5 s budget.
const typed = process.env.ESLINT_NO_TYPES !== '1';
const functionLength = { skipBlankLines: true, skipComments: true };

// An object with only `ignores` applies to every config object, the standard rules included.
// Global ignores of the project therefore go into this file, with an entry in `overrides`.
const isGlobalIgnore = (item) =>
  item !== null &&
  typeof item === 'object' &&
  'ignores' in item &&
  Object.keys(item).every((key) => key === 'ignores' || key === 'name');
const projectConfig = [project].flat(Infinity);
const dropped = projectConfig.filter(isGlobalIgnore);
if (dropped.length > 0) {
  console.warn(
    `global ignores of .config/eslint.project.mjs are dropped (${dropped.length}); add them to eslint.config.mjs`,
  );
}

export default defineConfig(
  { ignores: ['**/node_modules/', '**/dist/', '**/build/', '**/coverage/'] },
  // The parser comes before the project config, so a project setting such as
  // `allowDefaultProject` refines it; disableTypeChecked below still wins in fast mode.
  {
    files: ['**/*.{ts,tsx,mts,cts}'],
    languageOptions: {
      parserOptions: { projectService: typed, tsconfigRootDir: import.meta.dirname },
    },
  },
  ...projectConfig.filter((item) => !isGlobalIgnore(item)),
  {
    files: ['**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}'],
    languageOptions: { parser: tseslint.parser },
    plugins: { sonarjs },
    rules: {
      complexity: ['error', 10],
      'sonarjs/cognitive-complexity': ['error', 15],
      'max-depth': ['error', 4],
      'max-params': ['error', 4],
      'max-lines-per-function': ['error', { max: 80, ...functionLength }],
    },
  },
  {
    files: ['**/*.tsx'],
    rules: { 'max-lines-per-function': ['error', { max: 120, ...functionLength }] },
  },
  typed
    ? { files: ['**/*.{js,jsx,mjs,cjs}'], ...tseslint.configs.disableTypeChecked }
    : tseslint.configs.disableTypeChecked,
);
