#!/usr/bin/env -S uv run --script
#MISE description="Fail when .gitignore lacks a line of the standard block"
# /// script
# requires-python = ">=3.13"
# dependencies = ["pyyaml==6.0.3"]
# ///
"""Usage: check-gitignore-block [PATH ...]  (checks .gitignore; with paths, only if listed)

BLOCK and the rendered `.gitignore` of the template hold the same lines (a test keeps them equal).
With `terraform` in the `stack` of `.repo.yaml`, TERRAFORM_BLOCK is required too.
New lines arrive with a template update.
"""
import os
import subprocess
import sys
from pathlib import Path

import yaml

BLOCK = """\
docs/temp/
CLAUDE.local.md
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/commands/
!.claude/hooks/
"""
TERRAFORM_BLOCK = """\
.terraform/
*.tfstate*
"""


def stack(root: Path) -> list:
    """The `stack` answer of `.repo.yaml`; empty when the file is missing or unreadable."""
    try:
        answers = yaml.safe_load((root / ".repo.yaml").read_text())
    except (OSError, yaml.YAMLError):
        return []
    value = answers.get("stack") if isinstance(answers, dict) else None
    return value if isinstance(value, list) else []


def relative(root: Path, arg: str) -> str | None:
    """Repo-relative POSIX path without following symlinks; None when outside the root."""
    rel = os.path.relpath(os.path.normpath(os.path.abspath(arg)), os.path.abspath(root))
    return None if rel == ".." or rel.startswith("../") else Path(rel).as_posix()


def main(argv: list[str]) -> int:
    root = Path(subprocess.run(["git", "rev-parse", "--show-toplevel"], check=True,
                               capture_output=True, text=True).stdout.strip())
    if argv and ".gitignore" not in [r for a in argv if (r := relative(root, a))]:
        return 0
    path = root / ".gitignore"
    if not path.exists():
        print(".gitignore:1: file is missing")
        return 1
    present = {line.strip() for line in path.read_text().splitlines()}
    required = BLOCK + (TERRAFORM_BLOCK if "terraform" in stack(root) else "")
    missing = [line for line in required.splitlines() if line not in present]
    for line in missing:
        print(f".gitignore:1: missing line `{line}` of the standard block")
    lines = [line.strip() for line in path.read_text().splitlines()]
    misplaced = []
    if ".claude/*" in lines:
        anchor = lines.index(".claude/*")
        for number, line in enumerate(lines, 1):
            if line.startswith("!.claude/") and number - 1 < anchor:
                print(f".gitignore:{number}: `{line}` must come after `.claude/*`")
                misplaced.append(line)
    return 1 if missing or misplaced else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
