{% raw -%}
// Git hooks and checks of the repository standard.
// The hk package version matches `hk` in `.mise/conf.d/standard.toml`.
amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Builtins.pkl"

// Every step runs and reports, also after the first failure.
fail_fast = false

// A check script from `.mise/tasks/`; hk passes the files as separate arguments.
local function script(name: String, files: String | List<String>) = new Step {
  glob = files
  check = new Command { argv = List(".mise/tasks/\(name)", "{{files}}") }
}

// A tool installed by the package manager of the project.
local function bin(name: String) = "node_modules/.bin/\(name)"

// Fast checks on changed files.
local commitSteps = new Mapping<String, Step> {
{%- endraw %}
{%- if 'terraform' in stack %}
  ["terraform-fmt"] = Builtins.terraform
{%- endif %}
{%- if 'typescript' in stack %}
{%- raw %}
  ["prettier"] {
    glob = List("**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,css,scss}")
    // Files of the template keep its style whatever the project formatter says.
    exclude = List("eslint.config.mjs", ".dependency-cruiser.standard.cjs", "commitlint.config.mjs")
    check = new Command { argv = List(bin("prettier"), "--check", "--ignore-unknown", "{{files}}") }
    fix = new Command { argv = List(bin("prettier"), "--write", "--ignore-unknown", "{{files}}") }
  }
{%- endraw %}
{%- endif %}
{%- raw %}
  ["betterleaks"] = Builtins.betterleaks
  // `--assume-in-merge`: markers left by a conflicted template update fail outside a merge too.
  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["typos"] = Builtins.typos
  ["rumdl"] = Builtins.rumdl
  ["check-md-placement"] = script("check-md-placement", List("**/*.md", "**/*.MD"))
  ["check-agents-md"] = script("check-agents-md", "AGENTS.md")
  ["check-tasks-format"] = script("check-tasks-format", "docs/tasks.md")
  // The schema is an input too, so any change validates the whole `.repo.yaml`.
  ["check-repo-yaml"] {
    glob = List(".repo.yaml", ".github/repo.schema.json")
    check = ".mise/tasks/check-repo-yaml"
  }
  ["check-env-example"] = script("check-env-example", "**/*")
  ["check-gitignore-block"] = script("check-gitignore-block", ".gitignore")
  // Limits per extension are in `.mise/data/size-limits.json`.
  ["check-size"] = script("check-size", "**/*")
  ["check-comments"] = script(
    "check-comments",
    List("**/*.ts", "**/*.tsx", "**/*.js", "**/*.mjs", "**/*.php", "**/*.tf", "**/*.py", "**/*.sh")
  )
}

{%- endraw %}
{%- if 'typescript' in stack %}
{%- raw %}

local code = List("**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}")

// Pre-commit only: the same rules without type information; `check` runs the full ESLint.
local fastLint = new Mapping<String, Step> {
  ["eslint-fast"] {
    glob = code
    env { ["ESLINT_NO_TYPES"] = "1" }
    check = new Command { argv = List(bin("eslint"), "--no-warn-ignored", "{{files}}") }
  }
}
{%- endraw %}
{%- else %}
{%- raw %}

local fastLint = new Mapping<String, Step> {}
{%- endraw %}
{%- endif %}
{%- raw %}

// Slower checks before a push.
local pushSteps = new Mapping<String, Step> {
{%- endraw %}
{%- if 'terraform' in stack %}
  // The repository config applies to every module; without `--config` tflint
  // reads `.tflint.hcl` only from the directory it lints.
  ["tflint"] = (Builtins.tf_lint) {
    check = #"tflint --recursive --config="$PWD/.tflint.hcl""#
    fix = #"tflint --recursive --config="$PWD/.tflint.hcl" --fix"#
  }
  ["tf-validate"] {
    glob = List("**/*.tf", "**/*.tfvars", "**/.terraform.lock.hcl")
    exclude = "**/.terraform/**"
    check = ".mise/tasks/tf-validate"
  }
{%- endif %}
{%- if 'typescript' in stack %}
{%- raw %}
  // `typecheck` and `test` are scripts of the root `package.json`.
  ["typecheck"] {
    glob = code
    check = "npm run --silent typecheck"
  }
  ["eslint"] {
    glob = code
    check = new Command { argv = List(bin("eslint"), "--no-warn-ignored", "{{files}}") }
  }
  ["test"] {
    glob = code
    check = "npm run --silent test"
  }
  // The standard config alone: a project rule of the same name or a wider `exclude` would replace it on `extends`.
  ["dependency-cruiser-standard"] {
    glob = code
    check = new Command {
      argv = List(bin("depcruise"), "--config", ".dependency-cruiser.standard.cjs", "--output-type", "err", ".")
    }
  }
  ["dependency-cruiser"] {
    glob = code
    check = new Command { argv = List(bin("depcruise"), "--config", ".dependency-cruiser.cjs", "--output-type", "err", ".") }
  }
  ["knip"] {
    glob = List("**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}", "**/package.json")
    check = new Command { argv = List(bin("knip"), "--no-progress") }
  }
{%- endraw %}
{%- set steiger = namespace(n=0) %}
{%- for part, value in architecture.items() %}
{%- set style = value if value is string else ((value.style or '') if value is mapping else '') %}
{%- if 'fsd' in style | lower or 'feature-sliced' in style | lower %}
{%- set steiger.n = steiger.n + 1 %}
  ["steiger-{{ steiger.n }}"] {
    glob = List("{{ part }}/**")
{%- if value is mapping and value.script %}
    // Project script from `architecture` in .repo.yaml: Steiger with exceptions it cannot express.
    check = new Command { argv = List("npm", "run", "--silent", "{{ value.script }}") }
{%- else %}
    check = new Command { argv = List(bin("steiger"), "{{ part }}") }
{%- endif %}
  }
{%- endif %}
{%- endfor %}
{%- endif %}
{%- raw %}
  // Internal links only; external links are checked on a schedule.
  ["lychee"] = (Builtins.lychee) {
    types = null
    glob = List("**/*.md")
    check = new Command { argv = List("lychee", "--offline", "--no-progress", "{{files}}") }
  }
}

hooks {
  ["pre-commit"] {
    steps {
      ...commitSteps
      ...fastLint
    }
  }
  ["commit-msg"] {
    steps {
      ["commitlint"] {
        check = new Command { argv = List("commitlint", "--edit", "{{commit_msg_file}}") }
      }
    }
  }
  ["pre-push"] {
    steps = pushSteps
  }
  ["check"] {
    steps {
      ...commitSteps
      ...pushSteps
    }
  }
}
{%- endraw %}
