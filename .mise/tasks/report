#!/usr/bin/env -S uv run --script
#MISE description="Collect the scheduled report findings and open or update the `report` pull request"
# /// script
# requires-python = ">=3.13"
# dependencies = ["pyyaml==6.0.3"]
# ///
"""Usage: report [--dry-run | --print-monthly-due]

Environment: GITHUB_REPOSITORY, REPORT_SCHEDULE (monthly|weekly|twice-weekly),
REPORT_MANUAL=true for a manual run, DEFAULT_BRANCH (activity is scoped to it), GH_TOKEN for `gh`,
REPORT_APP_CONFIGURED=false when the report GitHub App is missing, REPORT_APP_SLUG for the commit author,
GITHUB_STEP_SUMMARY for the job summary.

Order: token expiry always, vulnerability alerts always with the report app; red merges, Skip-Check
trailers, template updates, protected files, new baseline files and stack drift only when the repository had activity
since `since_from_schedule`. The pure functions below are unit-tested; `fetch`
is the only place that runs `gh`.
"""
import functools
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
from datetime import UTC, date, datetime, timedelta
from pathlib import Path
from typing import Any, Callable

import yaml

# Period of the schedule plus one day for a delayed run: a repeated finding is
# cheaper than a missed red merge.
SINCE_DAYS = {"monthly": 32, "weekly": 8, "twice-weekly": 5}
MANUAL_DAYS = 8
BRANCH = "report"
RED = {"FAILURE", "ERROR", "TIMED_OUT", "STARTUP_FAILURE", "CANCELLED"}
SKIP_TRAILER = re.compile(r"^Skip-Check:\s*\S", re.I | re.M)
ADDED = {"added", "renamed", "copied"}
ASK_EDIT = re.compile(r"^Edit\(/(.+)\)$")
NO_APP = "report app is not configured, see docs/access.md"
NO_SLUG = "REPORT_APP_SLUG is not set; the report commit needs the app as its author"
VULN_NOT_CHECKED = "Not checked, needs the report app"
RENOVATE = {"app/renovate", "renovate[bot]"}
TEMPLATE_COMMIT = re.compile(r"^\+_commit:\s*(\S+)\s*$", re.M)
# Shown in the report, but not findings: they open no PR and add no backlog line.
INFO_SECTIONS = {"Template updates"}


def fetch(cmd: list[str]) -> Any:
    """Run a command and return its parsed JSON output (None when empty).

    Raises CalledProcessError on failure. Paged `gh api` results (--slurp) are flattened.
    """
    out = subprocess.run(cmd, check=True, capture_output=True, text=True).stdout.strip()
    if not out:
        return None
    data = json.loads(out)
    if isinstance(data, list) and data and all(isinstance(p, list) for p in data):
        data = [item for page in data for item in page]
    return data


@functools.cache
def check_baseline():
    """Module of the `check-baseline` task, loaded by path.

    The task has no `.py` extension and is a standalone script. Loading it keeps
    the baseline list in one place (`PROFILE_BASELINES`).
    """
    path = Path(__file__).resolve().parent / "check-baseline"
    loader = importlib.machinery.SourceFileLoader("check_baseline", str(path))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader("check_baseline", loader))
    loader.exec_module(module)
    return module


def baseline_files(root: Path) -> list[str]:
    """Baseline file names of `stack` in `root/.repo.yaml`."""
    return check_baseline().profile_files(root)


def new_baseline_files(added_by_pr: dict[int, list[str]], names: list[str]) -> dict[int, list[str]]:
    """Baseline files each PR added."""
    result = {n: [f for f in files if f in names] for n, files in added_by_pr.items()}
    return {n: hit for n, hit in result.items() if hit}


def code(text: str) -> str:
    """Inline code span: untrusted text in a PR body or tasks.md cannot @-mention anyone."""
    return "`" + " ".join(text.replace("`", "'").split()) + "`"


def run(cmd: list[str]) -> None:
    subprocess.run(cmd, check=True)


def since_from_schedule(now: datetime, schedule: str, manual: bool = False) -> datetime:
    """`now` minus the schedule period with a day of slack; no stored state."""
    if manual:
        return now - timedelta(days=MANUAL_DAYS)
    return now - timedelta(days=SINCE_DAYS[schedule])


def monthly_due(today: date, schedule: str, manual: bool = False) -> bool:
    """True on the first run of the report in the current month."""
    if manual or schedule == "monthly":
        return True
    if schedule == "weekly":
        return today.day <= 7
    if schedule == "twice-weekly":
        if today.weekday() == 0:
            return today.day <= 4
        if today.weekday() == 3:
            return today.day <= 3
    return False


def _parse_time(value: str) -> datetime | None:
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except (AttributeError, ValueError):
        return None
    return parsed if parsed.tzinfo else parsed.replace(tzinfo=UTC)


def has_activity(commits: list, prs: list, since: datetime) -> bool:
    """True if a commit or PR is dated at or after `since`; an undated item counts."""
    for item in commits:
        when = _parse_time(((item.get("commit") or {}).get("committer") or {}).get("date", ""))
        if when is None or when >= since:
            return True
    for item in prs:
        when = _parse_time(item.get("mergedAt") or item.get("updatedAt") or "")
        if when is None or when >= since:
            return True
    return False


def expiring_tokens(access_md: str, today: date, days: int = 30) -> list[str]:
    """Access names whose `Expires` date is within `days` of `today` or already past.

    `never`, empty cells, the `YYYY-MM-DD` placeholder and any other non-date value are unset.
    """
    columns: dict[str, int] | None = None
    found = []
    for line in access_md.splitlines():
        line = line.strip()
        if not line.startswith("|"):
            continue
        cells = [c.strip() for c in line.strip("|").split("|")]
        if columns is None:
            if "Access" in cells and "Expires" in cells:
                columns = {name: cells.index(name) for name in ("Access", "Expires")}
            continue
        if set("".join(cells)) <= set("-: "):
            continue
        if len(cells) <= max(columns.values()):
            continue
        try:
            expires = datetime.strptime(cells[columns["Expires"]], "%Y-%m-%d").date()
        except ValueError:
            continue
        if expires <= today + timedelta(days=days):
            found.append(cells[columns["Access"]])
    return found


def red_merges(prs: list[dict]) -> list[int]:
    """Numbers of merged PRs with a failed check in their rollup."""
    red = []
    for pr in prs:
        for check in pr.get("statusCheckRollup") or []:
            if (check.get("conclusion") or check.get("state") or "").upper() in RED:
                red.append(pr["number"])
                break
    return red


def skip_check_trailers(commits: list[dict]) -> list[str]:
    """`<sha7> <subject>` of commits carrying a `Skip-Check:` trailer."""
    found = []
    for item in commits:
        message = (item.get("commit") or {}).get("message", "")
        if SKIP_TRAILER.search(message):
            found.append(f"{item['sha'][:7]} {message.splitlines()[0]}")
    return found


def _glob(pattern: str) -> re.Pattern:
    parts = re.split(r"(\*\*|\*)", pattern)
    body = "".join(".*" if p == "**" else "[^/]*" if p == "*" else re.escape(p) for p in parts)
    return re.compile(body + r"\Z")


def protected_changes(files_by_pr: dict[int, list[str]], protected: list[str]) -> dict[int, list[str]]:
    """Files of each PR that match a protected pattern (`**` crosses directories)."""
    patterns = [_glob(p) for p in protected]
    result = {}
    for number, files in files_by_pr.items():
        hit = [f for f in files if any(p.match(f) for p in patterns)]
        if hit:
            result[number] = hit
    return result


def template_update(pr: dict, files: list[dict]) -> str | None:
    """Template version of a Renovate PR that changes `_commit` in .repo.yaml; None for any other PR."""
    if ((pr.get("author") or {}).get("login") or "") not in RENOVATE:
        return None
    for item in files:
        if item.get("filename") == ".repo.yaml" and (match := TEMPLATE_COMMIT.search(item.get("patch") or "")):
            return match.group(1)
    return None


def files_of_other_authors(commits: list[dict], files_of: Callable[[str], list[str]]) -> list[str]:
    """Files changed by commits of a template update PR whose author is not Renovate; an unknown author counts."""
    found: list[str] = []
    for item in commits:
        if ((item.get("author") or {}).get("login") or "") in RENOVATE:
            continue
        found += [f for f in files_of(item["sha"]) if f not in found]
    return found


def load_protected(root: Path) -> list[str]:
    """Protected paths: the `Edit(/<path>)` rules of `permissions.ask` in .claude/settings.json."""
    settings = json.loads((root / ".claude" / "settings.json").read_text())
    rules = (settings.get("permissions") or {}).get("ask") or []
    return [m.group(1) for rule in rules if (m := ASK_EDIT.match(rule))]


def stack_drift(detected: list[str], declared: list[str]) -> list[str]:
    drift = [f"`{s}` is in the code but not in `stack` of .repo.yaml" for s in sorted(set(detected) - set(declared))]
    drift += [f"`{s}` is in `stack` of .repo.yaml but not found in the code" for s in sorted(set(declared) - set(detected))]
    return drift


def render_report(sections: dict[str, list[str]]) -> str | None:
    """Markdown with the non-empty sections; None when there is nothing to report."""
    filled = {name: items for name, items in sections.items() if items}
    if not filled:
        return None
    blocks = [f"## {name}\n\n" + "\n".join(f"- {item}" for item in items) for name, items in filled.items()]
    return "\n\n".join(blocks) + "\n"


def contract_lag() -> list[str]:
    # TODO(docs/tasks.md): lag between the code and the contract; the contract is outside the plan.
    return []


def closed_cross_repo_tasks() -> list[str]:
    # TODO(docs/tasks.md): closed cross-repository tasks; multi-repo is outside the plan.
    return []


def collect(repo: str, root: Path, now: datetime, schedule: str, manual: bool = False,
            protected: list[str] | None = None, base: str | None = None,
            app: bool = True) -> dict[str, list[str]]:
    """Gather findings: always tokens and alerts, the rest only after activity."""
    sections: dict[str, list[str]] = {}
    access = root / "docs" / "access.md"
    today = now.date()
    sections["Tokens"] = [
        f"{name} expires soon or has expired"
        for name in expiring_tokens(access.read_text() if access.exists() else "", today)
    ]
    if not app:
        # The default token cannot read the alert setting; a check would report a false finding every run.
        sections["Vulnerability alerts"] = [VULN_NOT_CHECKED]
    else:
        try:
            fetch(["gh", "api", f"repos/{repo}/vulnerability-alerts"])
            sections["Vulnerability alerts"] = []
        except subprocess.CalledProcessError:
            sections["Vulnerability alerts"] = ["Vulnerability alerts are not enabled or not readable"]

    since = since_from_schedule(now, schedule, manual)
    stamp = since.strftime("%Y-%m-%dT%H:%M:%SZ")
    branch = f"&sha={base}" if base else ""
    commits = fetch(["gh", "api", "--paginate", "--slurp",
                     f"repos/{repo}/commits?since={stamp}&per_page=100{branch}"]) or []
    scope = ["--base", base] if base else []
    prs = fetch(["gh", "pr", "list", "--repo", repo, "--state", "merged", "--limit", "200", *scope,
                 "--search", f"merged:>={since:%Y-%m-%d}",
                 "--json", "number,mergedAt,statusCheckRollup,author"]) or []
    prs = [p for p in prs if (_parse_time(p.get("mergedAt", "")) or since) >= since]
    open_prs = fetch(["gh", "pr", "list", "--repo", repo, "--state", "open", "--limit", "200", *scope,
                      "--json", "number,updatedAt"]) or []
    open_prs = [p for p in open_prs if (_parse_time(p.get("updatedAt", "")) or since) >= since]
    if has_activity(commits, prs + open_prs, since):
        sections["Red merges"] = [f"#{n}" for n in red_merges(prs)]
        sections["Skip-Check"] = [code(t) for t in skip_check_trailers(commits)]
        changed = {p["number"]: fetch(
            ["gh", "api", "--paginate", "--slurp", f"repos/{repo}/pulls/{p['number']}/files"]) or [] for p in prs}
        files = {n: [f["filename"] for f in fs] for n, fs in changed.items()}
        updates = {p["number"]: v for p in prs if (v := template_update(p, changed[p["number"]]))}
        for number in updates:
            # Renovate commits of a template update change protected files by design; other commits stay findings.
            commits_of_pr = fetch(["gh", "api", "--paginate", "--slurp", f"repos/{repo}/pulls/{number}/commits"]) or []
            files[number] = files_of_other_authors(commits_of_pr, lambda sha: [
                f["filename"] for f in (fetch(["gh", "api", f"repos/{repo}/commits/{sha}"]) or {}).get("files") or []])
        sections["Template updates"] = [f"#{n}: {code(v)}" for n, v in updates.items()]
        added = {n: [f["filename"] for f in fs if f.get("status") in ADDED] for n, fs in changed.items()}
        if protected is None:
            protected = load_protected(root)
        sections["Protected files"] = [f"#{n}: {', '.join(code(f) for f in fs)}" for n, fs in protected_changes(files, protected).items()]
        sections["New baseline files"] = [
            f"#{n}: {', '.join(code(f) for f in fs)}"
            for n, fs in new_baseline_files(added, baseline_files(root)).items()]
        detected = (fetch(["mise", "run", "detect-stack"]) or {}).get("stack", [])
        declared_file = root / ".repo.yaml"
        declared = ((yaml.safe_load(declared_file.read_text()) if declared_file.exists() else None) or {}).get("stack") or []
        sections["Stack"] = stack_drift(detected, declared)
    sections["Contract"] = contract_lag()
    sections["Cross-repository tasks"] = closed_cross_repo_tasks()
    return sections


# One backlog line per kind of finding; the details and the date stay in the PR description.
BACKLOG = {
    "Tokens": ("Replace the expiring tokens of `docs/access.md`", "they expire within 30 days or have expired."),
    "Vulnerability alerts": ("Enable vulnerability alerts of the repository", "the report cannot read open alerts."),
    "Red merges": ("Investigate failed checks of merged pull requests {items}",
                   "a merge with a red check skips the gate."),
    "Skip-Check": ("Review commits with a `Skip-Check` trailer: {items}", "the trailer skips a check."),
    "Protected files": ("Review changes to protected files in {items}",
                        "they change how checks run outside a template update."),
    "New baseline files": ("Review new baseline files in {items}", "a baseline hides existing violations."),
    "Stack": ("Update `stack` of `.repo.yaml` to match the code", "the profile checks follow `stack`."),
}
PR_REF = re.compile(r"^#\d+")


def _subjects(items: list[str]) -> str:
    """PR numbers for per-PR findings, the item text otherwise."""
    refs = [m.group(0) for item in items if (m := PR_REF.match(item))]
    return ", ".join(refs) if len(refs) == len(items) else ", ".join(items)


def backlog_lines(sections: dict[str, list[str]]) -> list[str]:
    """Backlog lines `- <action> — <reason>` for docs/tasks.md; parentheses would read as repository names."""
    lines = []
    for name, items in sections.items():
        if not items:
            continue
        action, reason = BACKLOG.get(name, (f"Investigate the report section {name}", "see the report pull request."))
        text = action.format(items=_subjects(items)).replace("(", "[").replace(")", "]")
        lines.append(f"- {' '.join(text.split())} — {reason}")
    return lines


def bot_identity(slug: str) -> tuple[str, str]:
    """Commit name and email of the GitHub App bot; another address would credit a user account."""
    login = f"{slug}[bot]"
    user = fetch(["gh", "api", f"/users/{login}"]) or {}
    return login, f"{user['id']}+{login}@users.noreply.github.com"


def open_report_pr() -> int | None:
    existing = fetch(["gh", "pr", "list", "--head", BRANCH, "--state", "open", "--json", "number"]) or []
    return existing[0]["number"] if existing else None


def findings_only(sections: dict[str, list[str]]) -> dict[str, list[str]]:
    return {name: items for name, items in sections.items() if name not in INFO_SECTIONS}


def publish(sections: dict[str, list[str]], root: Path, stamp: str, slug: str = "",
            runner: Callable[[list[str]], Any] = run) -> str | None:
    """Open or update the `report` PR with the findings; without findings close an open one."""
    if render_report(findings_only(sections)) is None:
        if (number := open_report_pr()) is not None:
            runner(["gh", "pr", "close", str(number), "--comment", f"no findings in the report of {stamp}"])
        return None
    if not slug:
        raise SystemExit(NO_SLUG)
    body = f"Report of {stamp}.\n\n{render_report(sections)}"
    tasks = root / "docs" / "tasks.md"
    text = tasks.read_text()
    new = [line for line in backlog_lines(findings_only(sections)) if line not in text.splitlines()]
    tasks.write_text(text.rstrip("\n") + "\n" + "".join(f"{line}\n" for line in new))
    name, email = bot_identity(slug)
    runner(["git", "config", "user.name", name])
    runner(["git", "config", "user.email", email])
    runner(["git", "checkout", "-B", BRANCH])
    runner(["git", "add", "docs/tasks.md"])
    runner(["git", "commit", "-m", "chore: update report", "--allow-empty"])
    runner(["git", "push", "--force", "origin", BRANCH])
    if (number := open_report_pr()) is not None:
        runner(["gh", "pr", "edit", str(number), "--body", body])
    else:
        runner(["gh", "pr", "create", "--title", "report", "--body", body, "--head", BRANCH])
    return body


def main(argv: list[str]) -> int:
    schedule = os.environ.get("REPORT_SCHEDULE", "weekly")
    manual = os.environ.get("REPORT_MANUAL") == "true"
    now = datetime.now(UTC)
    if argv == ["--print-monthly-due"]:
        print(f"monthly_due={str(monthly_due(now.date(), schedule, manual)).lower()}")
        return 0
    root = Path(".")
    no_app = os.environ.get("REPORT_APP_CONFIGURED") == "false"
    sections = collect(os.environ["GITHUB_REPOSITORY"], root, now, schedule, manual,
                       base=os.environ.get("DEFAULT_BRANCH") or None, app=not no_app)
    if no_app:
        sections["Report app"] = [NO_APP]
    text = render_report(sections) or "No findings."
    if argv == ["--dry-run"]:
        print(text)
        return 0
    if summary := os.environ.get("GITHUB_STEP_SUMMARY"):
        with open(summary, "a") as out:
            out.write(text + "\n")
    if no_app:
        # The default token cannot push or open a pull request; the findings stay in the job summary.
        print(f"::error::{NO_APP}" if os.environ.get("GITHUB_ACTIONS") == "true" else NO_APP, file=sys.stderr)
        return 1
    publish(sections, root, now.strftime("%Y-%m-%d"), os.environ.get("REPORT_APP_SLUG", ""))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
