#!/usr/bin/env -S uv run --script
#MISE description="Fail when a baseline file has more entries than at the base ref"
# /// script
# requires-python = ">=3.13"
# dependencies = ["pyyaml==6.0.3"]
# ///
"""Usage: check-baseline [--file PATH ...] [BASE_REF]

Compares the number of entries of every baseline file with `git show BASE_REF:FILE`;
growth fails. The files come from the profiles of `stack` in `.repo.yaml`
(PROFILE_BASELINES below); `--file` replaces that list (used by the tests).
A baseline file absent at the base is allowed only when `.repo.yaml` did not exist
at the base (migration), `_commit` changed (template update), or `stack` changed and
the file belongs to a profile added to `stack`. `stack` compares as a set, `_commit`
as raw text. A missing, non-mapping or invalid current `.repo.yaml` allows nothing.
With `--file` the files are not tied to profiles, so any `stack` change allows them.
Otherwise a new file counts as growth. Every new baseline file is printed with the
reason. Entries are the non-empty lines of a text file; JSON baselines compare:
`.baselines/eslint-suppressions.json` the sum of the counts; `.baselines/size.json` the number of
entries, the sum of the lines and each kept entry, so a rename passes; `.config/jscpd.json` the
`threshold`, which may not rise or disappear; a `.baselines/` file each entry, whose number
may not rise, whose `until` may not move later, and which may not be added.
"""
import json
import os
import subprocess
import sys
from pathlib import Path

import yaml

# Baseline files of every repository, and per profile.
BASE_BASELINES: list[str] = [".baselines/size.json", ".baselines/betterleaks.ignore", ".baselines/adr.json", ".baselines/comments.json"]
# Baselines of the standard checks with an `until` date per entry.
DATED = {".baselines/adr.json", ".baselines/comments.json"}
PROFILE_BASELINES: dict[str, list[str]] = {
    "terraform": [],
    "typescript": [".baselines/eslint-suppressions.json", ".config/jscpd.json"],
}


def relative(root: Path, arg: str) -> str | None:
    """Repo-relative POSIX path without following symlinks; None when outside the root."""
    rel = os.path.relpath(os.path.normpath(os.path.abspath(arg)), os.path.abspath(root))
    return None if rel == ".." or rel.startswith("../") else Path(rel).as_posix()


def git(root: Path, *args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["git", "-C", str(root), *args], capture_output=True, text=True)


def profile_files(root: Path) -> list[str]:
    path = root / ".repo.yaml"
    data = yaml.safe_load(path.read_text()) if path.exists() else None
    stack = data.get("stack") if isinstance(data, dict) else None
    files: list[str] = list(BASE_BASELINES)
    for profile in stack if isinstance(stack, list) else []:
        files += PROFILE_BASELINES.get(profile, [])
    return files


def read_answers(text: str) -> tuple[dict | None, str | None]:
    """Mapping of `.repo.yaml` and `_commit` as raw text; raises yaml.YAMLError."""
    data = yaml.safe_load(text)
    if not isinstance(data, dict):
        return None, None
    return data, (yaml.load(text, Loader=yaml.BaseLoader) or {}).get("_commit")


def stack_set(data: dict) -> set[str]:
    stack = data.get("stack")
    return {str(item) for item in stack} if isinstance(stack, list) else set()


def show_list(value: object) -> str:
    return "[" + ", ".join(str(item) for item in value) + "]" if isinstance(value, list) else "[]"


def classify(root: Path, ref: str) -> tuple[str, str, set[str]]:
    """Change of `.repo.yaml` between `ref` and the tree: (kind, text, added profiles).

    Kinds: invalid, missing, migration, commit, stack, none.
    """
    path = root / ".repo.yaml"
    try:
        now, commit_now = read_answers(path.read_text()) if path.is_file() else (None, None)
        shown = git(root, "show", f"{ref}:.repo.yaml")
        was, commit_was = read_answers(shown.stdout) if shown.returncode == 0 else (None, None)
    except yaml.YAMLError:
        return "invalid", "invalid YAML", set()
    if now is None:
        return "missing", "missing or not a mapping", set()
    if shown.returncode != 0:
        return "migration", ".repo.yaml absent at base", set()
    was = was or {}
    if commit_was != commit_now:
        return "commit", f"_commit changed: {commit_was} -> {commit_now}", set()
    if stack_set(was) != stack_set(now):
        text = f"stack changed: {show_list(was.get('stack'))} -> {show_list(now.get('stack'))}"
        return "stack", text, stack_set(now) - stack_set(was)
    return "none", "", set()


def count(text: str) -> int:
    return sum(1 for line in text.splitlines() if line.strip())


def suppressions(data: object) -> int:
    files = data.values() if isinstance(data, dict) else []
    rules = [r for f in files if isinstance(f, dict) for r in f.values() if isinstance(r, dict)]
    return sum(int(r.get("count", 0)) for r in rules)


def dated_growth(before: str | None, after: str | None) -> list[str]:
    """Growth of a `.baselines/` file: {path: {<number>: n, "until": date}}."""
    try:
        old = json.loads(before) if before else {}
        new = json.loads(after) if after else {}
    except ValueError as err:
        return [f"invalid JSON: {err}"]
    if not isinstance(old, dict) or not isinstance(new, dict):
        return ["not an object"]
    found = []
    for key, entry in new.items():
        was = old.get(key)
        if not isinstance(was, dict) or not isinstance(entry, dict):
            found.append(f"{key} added")
            continue
        found += [f"{key}: {field} grew from {was[field]} to {value}" for field, value in entry.items()
                  if field != "until" and isinstance(value, int) and isinstance(was.get(field), int) and value > was[field]]
        if str(entry.get("until", "")) > str(was.get("until", "")):
            found.append(f"{key}: until moved from {was.get('until')} to {entry.get('until')}")
    return found


def growth(name: str, before: str | None, after: str | None) -> list[str]:
    """Messages for every way the baseline `name` grew between the two texts."""
    kind = Path(name).as_posix()
    if kind in DATED:
        return dated_growth(before, after)
    if kind not in (".baselines/eslint-suppressions.json", ".baselines/size.json", ".config/jscpd.json"):
        old, new = count(before or ""), count(after or "")
        return [f"baseline grew from {old} to {new} entries"] if new > old else []
    try:
        old = json.loads(before) if before else {}
        new = json.loads(after) if after else {}
    except ValueError as err:
        return [f"invalid JSON: {err}"]
    if kind == ".baselines/eslint-suppressions.json":
        old, new = suppressions(old), suppressions(new)
        return [f"baseline grew from {old} to {new} suppressions"] if new > old else []
    if kind == ".config/jscpd.json":
        was = old.get("threshold") if isinstance(old, dict) else None
        now = new.get("threshold") if isinstance(new, dict) else None
        if was is None:
            return []
        if not isinstance(now, (int, float)):
            return ["threshold removed"]
        return [f"threshold grew from {was} to {now}"] if now > was else []
    old = {k: v for k, v in old.items() if isinstance(v, int)} if isinstance(old, dict) else {}
    new = {k: v for k, v in new.items() if isinstance(v, int)} if isinstance(new, dict) else {}
    found = [f"{k} grew from {old[k]} to {v} lines" for k, v in new.items() if k in old and v > old[k]]
    if len(new) > len(old):
        found.append(f"baseline grew from {len(old)} to {len(new)} entries")
    if sum(new.values()) > sum(old.values()):
        found.append(f"baseline grew from {sum(old.values())} to {sum(new.values())} lines")
    return found


def parse(argv: list[str]) -> tuple[list[str], list[str]]:
    files, refs = [], []
    it = iter(argv)
    for arg in it:
        if arg == "--file":
            files.append(next(it, ""))
        elif arg.startswith("--file="):
            files.append(arg.removeprefix("--file="))
        else:
            refs.append(arg)
    return files, refs


def main(argv: list[str]) -> int:
    top = git(Path.cwd(), "rev-parse", "--show-toplevel")
    if top.returncode != 0:
        print("not a git repository")
        return 1
    root = Path(top.stdout.strip())
    files, refs = parse(argv)
    if not refs or git(root, "rev-parse", "--verify", "-q", "HEAD").returncode != 0:
        print("no base ref, skipped")
        return 0
    ref = refs[0]
    if ref.startswith("-") or git(root, "cat-file", "-e", f"{ref}^{{commit}}").returncode != 0:
        print(f"base ref {ref} not found")
        return 1

    names = []
    for arg in files:
        rel = relative(root, arg)
        if rel is None:
            print(f"{arg}:1: file is outside the repository")
            return 1
        names.append(rel)
    names = names or profile_files(root)

    failed = False
    change: tuple[str, str, set[str]] | None = None
    for name in names:
        shown = git(root, "show", f"{ref}:{name}")
        path = root / name
        if shown.returncode != 0 and path.is_file():
            if change is None:
                change = classify(root, ref)
                if change[0] in ("invalid", "missing"):
                    print(f".repo.yaml:1: {change[1]}")
            kind, text, added = change
            owned = {f for profile in added for f in PROFILE_BASELINES.get(profile, [])}
            if kind in ("migration", "commit") or (kind == "stack" and (files or name in owned)):
                print(f"{name}: new baseline file allowed: {text}")
            elif kind == "stack":
                print(f"{name}:1: new baseline file of a profile not added to stack ({text})")
                failed = True
            else:
                print(f"{name}:1: new baseline file without .repo.yaml change")
                failed = True
            continue
        before = shown.stdout if shown.returncode == 0 else None
        for message in growth(name, before, path.read_text() if path.is_file() else None):
            print(f"{name}:1: {message}")
            failed = True
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
