#!/usr/bin/env -S uv run --script
#MISE description="Print true when a merged pull request with green CI contains the commit, else false"
# /// script
# requires-python = ">=3.13"
# ///
"""Usage: ci-merged-pr REPO SHA

`standard-ci` calls it on a push to a required branch: a commit of a merged pull
request was already checked in the pull request, so CI skips `mise run check`.
Only a pull request with `merged_at` counts: an open pull request whose head is the
pushed commit was not merged. Its head must carry a completed, successful `check`
run: without branch protection a pull request can be merged with red or running CI.
Any error prints false, so CI runs every check.
`GH` overrides the command (default `gh`).
"""
import json
import os
import re
import shlex
import subprocess
import sys

REPO = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9_.-]+")
SHA = re.compile(r"[0-9a-f]{40}")


def merged(repo: str, sha: str) -> bool:
    if not REPO.fullmatch(repo) or not SHA.fullmatch(sha):
        print(f"invalid repository or commit: {repo} {sha}", file=sys.stderr)
        return False
    gh = shlex.split(os.environ.get("GH", "gh"))
    command = [*gh, "api", f"repos/{repo}/commits/{sha}/pulls"]
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as err:
        print(f"cannot run {command[0]}: {err}", file=sys.stderr)
        return False
    if result.returncode != 0:
        print(result.stderr.strip(), file=sys.stderr)
        return False
    try:
        pulls = json.loads(result.stdout)
    except json.JSONDecodeError:
        print("unexpected answer of the pulls API", file=sys.stderr)
        return False
    if not isinstance(pulls, list):
        return False
    heads = [((p.get("head") or {}).get("sha") or "") for p in pulls if isinstance(p, dict) and p.get("merged_at")]
    return any(SHA.fullmatch(head) and green(repo, head, gh) for head in heads)


def green(repo: str, sha: str, gh: list[str]) -> bool:
    """True when every latest `check` run of the commit completed with success."""
    command = [*gh, "api", f"repos/{repo}/commits/{sha}/check-runs?check_name=check&per_page=100"]
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=60)
        runs = json.loads(result.stdout).get("check_runs") if result.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError, AttributeError) as err:
        print(f"cannot read the checks of {sha}: {err}", file=sys.stderr)
        return False
    if result.returncode != 0:
        print(result.stderr.strip(), file=sys.stderr)
        return False
    return bool(runs) and all(r.get("status") == "completed" and r.get("conclusion") == "success" for r in runs)


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print("usage: ci-merged-pr REPO SHA", file=sys.stderr)
        return 1
    print("true" if merged(*argv) else "false")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
