{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {"enabled": true, "minimumReleaseAge": null, "groupName": null, "schedule": ["at any time"]},
  "lockFileMaintenance": {"enabled": true, "schedule": ["* 0-5 * * 1"]},
  "copier": {"managerFilePatterns": ["/(^|/)\\.repo\\.yaml$/"]},
  "semanticCommits": "enabled",
  "ignorePaths": [".mise/conf.d/standard.toml", ".github/workflows/standard-*.yml"],
  "platformAutomerge": false,
  "packageRules": [
    {"matchManagers": ["github-actions"], "groupName": "github actions"},
    {"matchManagers": ["mise"], "groupName": "mise tools"},
    {"matchUpdateTypes": ["minor", "patch", "pin", "digest"], "groupName": "non-major dependencies", "schedule": ["* 0-5 * * 1"]},
    {"matchManagers": ["copier"], "minimumReleaseAge": null, "automerge": false, "groupName": null, "schedule": ["at any time"]},
    {"matchManagers": ["copier"], "matchDepNames": ["/^gh:/"], "overridePackageName": "{{{replace '^gh:' 'https://github.com/' depName}}}"},
    {"matchManagers": ["copier"], "matchDepNames": ["/^gl:/"], "overridePackageName": "{{{replace '^gl:' 'https://gitlab.com/' depName}}}"},
    {"matchManagers": ["custom.regex"], "groupName": "mise tools"},
    {"matchFileNames": ["template/**"], "automerge": false}
  ],
  "github-actions": {"managerFilePatterns": ["/^template/\\.github/workflows/.+\\.ya?ml\\.jinja$/"]},
  "mise": {"managerFilePatterns": ["/^template/\\.mise/conf\\.d/.+\\.toml\\.jinja$/"]},
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^template/\\.config/hk\\.pkl\\.jinja$/"],
      "matchStrings": [
        "releases/download/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/hk@",
        "/hk@(?<currentValue>\\d+\\.\\d+\\.\\d+)#"
      ],
      "depNameTemplate": "jdx/hk",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ]
}
