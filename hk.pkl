// Git hooks and checks of the repository standard.
// The hk package version matches `hk` in `.mise/conf.d/standard.toml`.
amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Builtins.pkl"

// Every step runs and reports, also after the first failure.
fail_fast = false

// A check script from `.mise/tasks/`; hk passes the files as separate arguments.
local function script(name: String, files: String | List<String>) = new Step {
  glob = files
  check = new Command { argv = List(".mise/tasks/\(name)", "{{files}}") }
}

// A tool installed by the package manager of the project.
local function bin(name: String) = "node_modules/.bin/\(name)"

// Fast checks on changed files.
local commitSteps = new Mapping<String, Step> {
  ["betterleaks"] = Builtins.betterleaks
  // `--assume-in-merge`: markers left by a conflicted template update fail outside a merge too.
  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["typos"] = Builtins.typos
  ["rumdl"] = Builtins.rumdl
  ["check-md-placement"] = script("check-md-placement", List("**/*.md", "**/*.MD"))
  ["check-agents-md"] = script("check-agents-md", "AGENTS.md")
  ["check-tasks-format"] = script("check-tasks-format", "docs/tasks.md")
  // The schema is an input too, so any change validates the whole `.repo.yaml`.
  ["check-repo-yaml"] {
    glob = List(".repo.yaml", ".github/repo.schema.json")
    check = ".mise/tasks/check-repo-yaml"
  }
  ["check-env-example"] = script("check-env-example", "**/*")
  ["check-gitignore-block"] = script("check-gitignore-block", ".gitignore")
  // Limits per extension are in `.mise/data/size-limits.json`.
  ["check-size"] = script("check-size", "**/*")
  ["check-comments"] = script(
    "check-comments",
    List("**/*.ts", "**/*.tsx", "**/*.js", "**/*.mjs", "**/*.php", "**/*.tf", "**/*.py", "**/*.sh")
  )
}

local fastLint = new Mapping<String, Step> {}

// Slower checks before a push.
local pushSteps = new Mapping<String, Step> {
  // Internal links only; external links are checked on a schedule.
  ["lychee"] = (Builtins.lychee) {
    types = null
    glob = List("**/*.md")
    check = new Command { argv = List("lychee", "--offline", "--no-progress", "{{files}}") }
  }
}

hooks {
  ["pre-commit"] {
    steps {
      ...commitSteps
      ...fastLint
    }
  }
  ["commit-msg"] {
    steps {
      ["commitlint"] {
        check = new Command { argv = List("commitlint", "--edit", "{{commit_msg_file}}") }
      }
    }
  }
  ["pre-push"] {
    steps = pushSteps
  }
  ["check"] {
    steps {
      ...commitSteps
      ...pushSteps
    }
  }
}
